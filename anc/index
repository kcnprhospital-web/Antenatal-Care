function getCache(){ try{ return JSON.parse(localStorage.getItem(LS_CACHE)); }catch(e){ return null; } }
function setCache(r){ try{ localStorage.setItem(LS_CACHE,JSON.stringify(r)); }catch(e){} }
function jsonpList(url,limit){ return new Promise((resolve,reject)=>{ const cb='__hrp_cb_'+Date.now()+'_'+Math.floor(Math.random()*1e6); const s=document.createElement('script'); let done=false;
  const cleanup=()=>{ try{delete window[cb];}catch(e){window[cb]=undefined;} if(s.parentNode)s.parentNode.removeChild(s); };
  const timer=setTimeout(()=>{ if(done)return; done=true; cleanup(); reject(new Error('timeout')); },25000);
  window[cb]=(p)=>{ if(done)return; done=true; clearTimeout(timer); cleanup(); resolve(p); };
  s.onerror=()=>{ if(done)return; done=true; clearTimeout(timer); cleanup(); reject(new Error('script error')); };
  let q='action=list&register='+encodeURIComponent(REGISTER)+'&callback='+cb+'&_='+Date.now();
  if(limit&&limit>0) q+='&limit='+limit;
  s.src=url+(url.indexOf('?')>-1?'&':'?')+q;
  document.head.appendChild(s); }); }

function setStatus(html,isErr){ const el=document.getElementById('loadStatus'); if(!el)return; el.className='load-status'+(isErr?' err':''); el.innerHTML=html; }
function setRefreshLoading(on){ const b=document.getElementById('refreshBtn'); if(!b)return; b.disabled=on; b.textContent=on?'⏳ កំពុងផ្ទុក...':'🔄 ផ្ទុកឡើងវិញ'; }
function hhmm(d){ const p=n=>String(n).padStart(2,'0'); return p(d.getHours())+':'+p(d.getMinutes()); }
function renderLoadStatus(){
  const parts=['កំណត់ត្រា៖ '+allRows.length+(totalCount&&totalCount!==allRows.length?' / '+totalCount:'')];
  if(lastUpdated) parts.push('ធ្វើបច្ចុប្បន្នភាព '+hhmm(lastUpdated));
  let html=parts.join(' · ');
  if(totalCount>allRows.length) html+=' <button type="button" class="loadall" id="loadAllBtn">ផ្ទុកទាំងអស់ ('+totalCount+')</button>';
  setStatus(html);
  const la=document.getElementById('loadAllBtn'); if(la) la.addEventListener('click',()=>loadDashboard({all:true}));
}

async function loadDashboard(opts){
  opts=opts||{}; const all=(opts.all!==undefined)?opts.all:true;
  const url=getScriptUrl(), tbody=document.getElementById('tableBody');
  if(!url){ tbody.innerHTML='<tr><td colspan="9" class="empty">សូមកំណត់ Apps Script URL សិន</td></tr>'; return; }
  const cached=getCache();
  if(cached&&cached.length){ allRows=cached; renderTable(); } else tbody.innerHTML='<tr><td colspan="9" class="empty">កំពុងផ្ទុក...</td></tr>';
  setRefreshLoading(true); setStatus('កំពុងផ្ទុកទិន្នន័យ...');
  try{
    await flushPending();
    const json=await jsonpList(url, all?0:500);
    if(json&&json.error) throw new Error(json.error);
    allRows=(json&&json.data)||[];
    totalCount=(json&&json.total!=null)?json.total:allRows.length;
    fullyLoaded=!(json&&json.truncated);
    lastUpdated=new Date();
    if(fullyLoaded) reconcilePending(allRows);
    setCache(allRows); renderTable(); renderLoadStatus();
  }catch(e){
    const msg=(e&&e.message==='timeout')?'ការផ្ទុកយូរពេក — សូមព្យាយាមម្តងទៀត':('✗ ផ្ទុកមិនបាន — '+(e&&e.message||'error')+'. សូមប្រាកដថា Code.gs ត្រូវបានដេប្លយ (New version, Anyone)។');
    setStatus(msg+(cached&&cached.length?' — កំពុងបង្ហាញទិន្នន័យចាស់':''), true);
    if(!(cached&&cached.length)) tbody.innerHTML='<tr><td colspan="9" class="empty">'+msg+'</td></tr>';
  }finally{ setRefreshLoading(false); }
}
async function ensureAllLoaded(){ if(!fullyLoaded) await loadDashboard({all:true}); }
function getFilteredRows(){ const hc=document.getElementById('fltHc').value,risk=document.getElementById('fltRisk').value,from=document.getElementById('fltFrom').value,to=document.getElementById('fltTo').value;
  return allRows.filter(r=>{ if(hc&&r.hcName!==hc)return false; if(risk&&r.riskLevel!==risk)return false; if(from&&r.attendDate&&r.attendDate<from)return false; if(to&&r.attendDate&&r.attendDate>to)return false; return true; }); }
function activePeriodText(){ const f=document.getElementById('fltFrom').value,t=document.getElementById('fltTo').value; if(f&&t)return f+' ដល់ '+t; if(f)return 'ចាប់ពី '+f; if(t)return 'រហូតដល់ '+t; return 'កាលបរិច្ឆេទទាំងអស់'; }
function activeFilterText(){ const hc=document.getElementById('fltHc').value,risk=document.getElementById('fltRisk').value,p=[]; if(hc)p.push('មូលដ្ឋាន៖ '+hc); if(risk)p.push('ហានិភ័យ៖ '+(RISK_KM[risk]||risk)); return p.length?p.join(' · '):'ទាំងអស់'; }
function riskPillHtml(r){ const m={low:['🟢 ទាប','low'],med:['🟡 មធ្យម','med'],high:['🔴 ខ្ពស់','high']}[r]||['—','']; return '<span class="pill '+m[1]+'">'+m[0]+'</span>'; }
function renderTable(){
  const rows=getFilteredRows();
  document.getElementById('statTotal').textContent=rows.length;
  document.getElementById('statLow').textContent=rows.filter(r=>r.riskLevel==='low').length;
  document.getElementById('statMed').textContent=rows.filter(r=>r.riskLevel==='med').length;
  document.getElementById('statHigh').textContent=rows.filter(r=>r.riskLevel==='high').length;
  const tbody=document.getElementById('tableBody');
  if(rows.length===0){ tbody.innerHTML='<tr><td colspan="9" class="empty">មិនមានទិន្នន័យត្រូវនឹងលក្ខខណ្ឌតម្រង</td></tr>'; return; }
  tbody.innerHTML=rows.slice().reverse().map(r=>`
    <tr>
      <td>${r.attendDate||''}</td>
