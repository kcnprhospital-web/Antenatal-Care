}
document.getElementById('refreshBtn').addEventListener('click',()=>loadDashboard());
['fltHc','fltRisk','fltFrom','fltTo'].forEach(id=>document.getElementById(id).addEventListener('change',async()=>{ await ensureAllLoaded(); renderTable(); }));

/* Edit & delete */
function recordKey(r){ return r.id||r.timestamp||''; }
function findRecord(rid){ return allRows.find(r=>(r.id||'')===rid||(r.timestamp||'')===rid); }
function keyMatches(r,key){ return (key.id&&(r.id||'')===key.id)||(key.timestamp&&(r.timestamp||'')===key.timestamp); }
function setVal(id,v){ const el=document.getElementById(id); if(el)el.value=(v===undefined||v===null)?'':v; }
function applyLocalAdd(d){ allRows=allRows.concat([d]); setCache(allRows); }
function applyLocalUpdate(key,d){ allRows=allRows.map(r=>keyMatches(r,key)?Object.assign({},r,d):r); setCache(allRows); renderTable(); }
function applyLocalDelete(key){ allRows=allRows.filter(r=>!keyMatches(r,key)); setCache(allRows); renderTable(); }
function startEdit(rid){
  const r=findRecord(rid); if(!r)return;
  editingKey={id:r.id||'',timestamp:r.timestamp||''};
  const hcSel=document.getElementById('hcName'); hcSel.value=r.hcName||'';
  if(r.hcName&&hcSel.value!==r.hcName){ const o=document.createElement('option'); o.value=r.hcName;o.textContent=r.hcName+' (មិនមានក្នុងបញ្ជី)';o.dataset.temp='1';hcSel.appendChild(o);hcSel.value=r.hcName; }
  document.querySelectorAll('.risk-opt').forEach(o=>o.classList.remove('sel'));
  const ro=document.querySelector('.risk-opt[data-risk="'+(r.riskLevel||'')+'"]'); if(ro)ro.classList.add('sel');
  document.getElementById('riskLevel').value=r.riskLevel||'';
  ['attendDate','refNo','patName','patAge','outcome','remark'].forEach(k=>setVal(k,r[k]));
  document.getElementById('editBannerName').textContent=[r.patName,r.hcName,r.attendDate].filter(Boolean).join(' · ');
  document.getElementById('editBanner').classList.add('show');
  document.getElementById('submitBtn').textContent='✏️ រក្សាទុកការកែប្រែ (Update)';
  document.querySelector('.tab-btn[data-tab="entry"]').click(); window.scrollTo(0,0);
}
function finishEdit(){
  editingKey=null;
  document.getElementById('editBanner').classList.remove('show');
  document.getElementById('submitBtn').textContent='💾 រក្សាទុកវត្តមាន (Save)';
  document.getElementById('entryForm').reset();
  Array.from(document.querySelectorAll('#hcName option[data-temp]')).forEach(o=>o.remove());
  document.getElementById('attendDate').value=todayStr();
  document.querySelectorAll('.risk-opt').forEach(o=>o.classList.remove('sel'));
  document.getElementById('riskLevel').value='';
}
function removeRecord(rid){
  const r=findRecord(rid); if(!r)return;
  const label=[r.patName,r.hcName,r.attendDate].filter(Boolean).join(' · ');
  if(!confirm('លុបកំណត់ត្រានេះ?\n\n'+label+'\n\nសកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។'))return;
  const key={id:r.id||'',timestamp:r.timestamp||''};
  purgeQueuedFor(key.id); queueEntry({action:'deleteReferral',key:key}); applyLocalDelete(key); flushPending();
}
document.getElementById('tableBody').addEventListener('click',(e)=>{ const ed=e.target.closest('.row-btn.edit'),dl=e.target.closest('.row-btn.del'); if(ed)startEdit(ed.dataset.rid); else if(dl)removeRecord(dl.dataset.rid); });
document.getElementById('cancelEditBtn').addEventListener('click',()=>{ finishEdit(); document.querySelector('.tab-btn[data-tab="dashboard"]').click(); });

/* Excel export */
const XLS_COLS=[
  {key:'attendDate',header:'កាលបរិច្ឆេទមកដល់',width:16},
  {key:'hcName',header:'មូលដ្ឋានសុខាភិបាលបញ្ជូន',width:30},
  {key:'refNo',header:'លេខលិខិត',width:12},
  {key:'patName',header:'ឈ្មោះស្ត្រី',width:22},
  {key:'patAge',header:'អាយុ',width:8},
  {key:'riskKm',header:'កម្រិតហានិភ័យ',width:14},
  {key:'outcome',header:'លទ្ធផល',width:22},
  {key:'remark',header:'កំណត់សម្គាល់',width:30},
  {key:'timestamp',header:'ពេលបញ្ចូល',width:22}
];
const XLS_NUMERIC=new Set(['patAge']);
async function exportExcel(){
  if(typeof ExcelJS==='undefined'){ alert('បណ្ណាល័យ Excel មិនទាន់ផ្ទុក'); return; }
  const rows=getFilteredRows(); if(!rows.length){ alert('គ្មានទិន្នន័យសម្រាប់នាំចេញ'); return; }
  const wb=new ExcelJS.Workbook(); const ws=wb.addWorksheet('ANC Attendance',{views:[{state:'frozen',ySplit:6}]});
  try{ const imgId=wb.addImage({base64:LOGO_B64,extension:'png'}); ws.addImage(imgId,{tl:{col:0.2,row:0.2},ext:{width:64,height:64}}); }catch(e){}
  try{ const ancId=wb.addImage({base64:ANC_LOGO,extension:'png'}); ws.addImage(ancId,{tl:{col:6.3,row:0.1},ext:{width:72,height:72}}); }catch(e){}
  ws.mergeCells('B1:E1'); ws.getCell('B1').value='មន្ទីរពេទ្យខេត្តកំពង់ឆ្នាំង · Kampong Chhnang Provincial Hospital'; ws.getCell('B1').font={bold:true,size:13,color:{argb:'FF0A3A3B'}};
  ws.mergeCells('B2:E2'); ws.getCell('B2').value='របាយការណ៍វត្តមានស្ត្រីមកពិនិត្យផ្ទៃពោះ (Antenatal Care / ANC Attendance)'; ws.getCell('B2').font={bold:true,size:11};
  ws.mergeCells('B3:E3'); ws.getCell('B3').value='រយៈពេល៖ '+activePeriodText()+'   |   តម្រង៖ '+activeFilterText(); ws.getCell('B3').font={size:10,color:{argb:'FF6B675C'}};
  ws.mergeCells('B4:E4'); ws.getCell('B4').value='នាំចេញ៖ '+new Date().toLocaleString('en-GB')+'   |   ចំនួន៖ '+rows.length; ws.getCell('B4').font={size:10,color:{argb:'FF6B675C'}};
  const hr=ws.getRow(6);
  XLS_COLS.forEach((c,i)=>{ const cell=hr.getCell(i+1); cell.value=c.header; cell.font={bold:true,color:{argb:'FFFFFFFF'},size:10}; cell.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF0A3A3B'}}; cell.alignment={vertical:'middle',horizontal:'center',wrapText:true}; ws.getColumn(i+1).width=c.width; });
  hr.height=28;
  const rf={low:'FFE7F3EA',med:'FFFBF1DE',high:'FFFBE9E8'}, rc={low:'FF3F8F5F',med:'FFC8912A',high:'FFB23B3B'};
  rows.forEach(r=>{ const vals=XLS_COLS.map(c=>{ if(c.key==='riskKm')return RISK_KM[r.riskLevel]||''; let v=r[c.key]; if(v===undefined||v===null)return ''; if(XLS_NUMERIC.has(c.key)&&v!==''&&!isNaN(v))return Number(v); return v; });
    const row=ws.addRow(vals); row.alignment={vertical:'top',wrapText:true};
    const rcell=row.getCell(6); if(rf[r.riskLevel]){ rcell.fill={type:'pattern',pattern:'solid',fgColor:{argb:rf[r.riskLevel]}}; rcell.font={bold:true,color:{argb:rc[r.riskLevel]}}; rcell.alignment={horizontal:'center',vertical:'middle'}; } });
  ws.autoFilter={from:{row:6,column:1},to:{row:6,column:XLS_COLS.length}};
  try{ const buf=await wb.xlsx.writeBuffer(); const blob=new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='ANC_Attendance_'+new Date().toISOString().slice(0,10)+'.xlsx'; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),4000); }
  catch(e){ alert('បរាជ័យក្នុងការបង្កើត Excel៖ '+e.message); }
}

/* PDF report */
function buildReportHtml(rows){
  const c={total:rows.length,low:rows.filter(r=>r.riskLevel==='low').length,med:rows.filter(r=>r.riskLevel==='med').length,high:rows.filter(r=>r.riskLevel==='high').length};
  const body=rows.slice().reverse().map((r,i)=>`<tr><td class="c">${i+1}</td><td class="c">${escHtml(r.attendDate||'')}</td><td>${escHtml(r.hcName||'')}</td><td class="c">${escHtml(r.refNo||'')}</td><td>${escHtml(r.patName||'')}</td><td class="c">${escHtml(r.patAge||'')}</td><td class="c risk-${r.riskLevel||''}">${r.riskLevel?(RISK_KM[r.riskLevel]||''):''}</td><td>${escHtml(r.outcome||'')}</td><td>${escHtml(r.remark||'')}</td></tr>`).join('');
  const today=new Date().toLocaleDateString('en-GB');
  return `<!DOCTYPE html><html lang="km"><head><meta charset="utf-8"><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Khmer:wght@400;600;700&family=Noto+Serif+Khmer:wght@600;700&display=swap" rel="stylesheet">
  <style>@page{size:A4 landscape;margin:12mm;}*{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact;}body{font-family:'Noto Sans Khmer',sans-serif;color:#1c2b2a;margin:0;font-size:11px;}
  .rh{display:flex;align-items:center;justify-content:space-between;gap:14px;border-bottom:3px solid #0a3a3b;padding-bottom:10px;margin-bottom:10px;}.rh .hosp{text-align:center;}.rh img{width:70px;height:70px;object-fit:contain;}.rh .anc{width:84px;height:84px;}.rh .kh{font-family:'Noto Serif Khmer',serif;font-size:16px;font-weight:700;color:#0a3a3b;margin:0;}.rh .en{font-size:11px;color:#444;margin:2px 0 0;}
  .rt{font-family:'Noto Serif Khmer',serif;font-size:15px;font-weight:700;text-align:center;margin:4px 0 2px;}.rm{text-align:center;font-size:10.5px;color:#555;margin-bottom:12px;}
  .sr{display:flex;gap:8px;margin-bottom:12px;}.sb{flex:1;border:1px solid #d8d3c4;border-radius:8px;padding:8px;text-align:center;}.sb .n{font-size:20px;font-weight:700;}.sb .l{font-size:10px;color:#666;}.sb.low .n{color:#3f8f5f;}.sb.med .n{color:#c8912a;}.sb.high .n{color:#b23b3b;}
  table{width:100%;border-collapse:collapse;font-size:10px;}th,td{border:1px solid #cfcabb;padding:4px 5px;text-align:left;vertical-align:top;}th{background:#0a3a3b;color:#fff;font-size:9.5px;}td.c{text-align:center;}.risk-low{background:#e7f3ea;color:#3f8f5f;font-weight:700;}.risk-med{background:#fbf1de;color:#c8912a;font-weight:700;}.risk-high{background:#fbe9e8;color:#b23b3b;font-weight:700;}tr{break-inside:avoid;}
  .ft{margin-top:24px;display:flex;justify-content:flex-end;}.sg{text-align:center;width:260px;font-size:11px;}.sg .ln{margin-top:50px;border-top:1px solid #333;padding-top:4px;}</style></head><body>
  <div class="rh"><div class="hosp"><img src="${LOGO_B64}"><p class="kh">មន្ទីរពេទ្យខេត្តកំពង់ឆ្នាំង</p><p class="en">Kampong Chhnang Provincial Hospital</p></div><img class="anc" src="${ANC_LOGO}" alt="ANC"></div>
  <div class="rt">របាយការណ៍វត្តមានស្ត្រីមកពិនិត្យផ្ទៃពោះ (ANC)</div>
  <div class="rm">ANC Attendance Report &nbsp;|&nbsp; រយៈពេល៖ ${activePeriodText()} &nbsp;|&nbsp; តម្រង៖ ${activeFilterText()}</div>
  <div class="sr"><div class="sb"><div class="n">${c.total}</div><div class="l">សរុប / Total</div></div><div class="sb low"><div class="n">${c.low}</div><div class="l">ទាប</div></div><div class="sb med"><div class="n">${c.med}</div><div class="l">មធ្យម</div></div><div class="sb high"><div class="n">${c.high}</div><div class="l">ខ្ពស់</div></div></div>
  <table><thead><tr><th>ល.រ</th><th>កាលបរិច្ឆេទ</th><th>មូលដ្ឋានបញ្ជូន</th><th>លេខលិខិត</th><th>ឈ្មោះស្ត្រី</th><th>អាយុ</th><th>ហានិភ័យ</th><th>លទ្ធផល</th><th>កំណត់សម្គាល់</th></tr></thead><tbody>${body}</tbody></table>
