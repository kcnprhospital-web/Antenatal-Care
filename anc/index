}
function exportPdf(){
  const rows=getFilteredRows(); if(rows.length===0){ alert('គ្មានទិន្នន័យសម្រាប់របាយការណ៍'); return; }
  const iframe=document.createElement('iframe'); iframe.style.cssText='position:fixed;right:0;bottom:0;width:0;height:0;border:0;'; document.body.appendChild(iframe);
  const doc=iframe.contentWindow.document; doc.open(); doc.write(buildReportHtml(rows)); doc.close();
  let printed=false; const go=()=>{ if(printed)return; printed=true; try{ iframe.contentWindow.focus(); iframe.contentWindow.print(); }catch(e){ alert('មិនអាចបោះពុម្ព៖ '+e.message); } setTimeout(()=>{ if(iframe.parentNode)iframe.parentNode.removeChild(iframe); },2000); };
  iframe.onload=()=>setTimeout(go,500); setTimeout(go,1200);
}
document.getElementById('exportExcelBtn').addEventListener('click',async()=>{ await ensureAllLoaded(); exportExcel(); });
document.getElementById('exportPdfBtn').addEventListener('click',async()=>{ await ensureAllLoaded(); exportPdf(); });

