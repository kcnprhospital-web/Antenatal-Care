      <td><div class="row-actions">
        <button type="button" class="row-btn edit" data-rid="${escHtml(recordKey(r))}">✏️ កែ</button>
        <button type="button" class="row-btn del" data-rid="${escHtml(recordKey(r))}">🗑️ លុប</button>
