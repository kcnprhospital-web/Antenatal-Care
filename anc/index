/* Outbox */
function getPending(){ try{ return JSON.parse(localStorage.getItem(LS_PENDING))||[]; }catch(e){ return []; } }
function setPending(a){ try{ localStorage.setItem(LS_PENDING,JSON.stringify(a)); }catch(e){} updatePendingNote(); }
function newQid(){ return 'q_'+Date.now()+'_'+Math.floor(Math.random()*1e9); }
function queueEntry(p){ p.qid=p.qid||newQid(); const q=getPending(); q.push(p); setPending(q); }
function recIdOf(it){ return (it&&it.data&&it.data.id)||(it&&it.key&&it.key.id)||''; }
function purgeQueuedFor(id){ if(!id)return; setPending(getPending().filter(it=>!((it.action==='addReferral'||it.action==='updateReferral')&&recIdOf(it)===id))); }
function reconcilePending(serverRows){
  const ids=new Set((serverRows||[]).map(r=>String(r.id||'')).filter(Boolean)); const q=getPending();
  const kept=q.filter(it=>{ const id=recIdOf(it); if(!id)return true; if(it.action==='addReferral'&&ids.has(id))return false; if(it.action==='deleteReferral'&&!ids.has(id))return false; return true; });
  if(kept.length!==q.length) setPending(kept); }
function updatePendingNote(){ const el=document.getElementById('pendingNote'); if(!el)return; const n=getPending().length; if(n>0){ el.style.display='block'; el.textContent='⏳ '+n+' ធាតុកំពុងរង់ចាំផ្ញើ — នឹងផ្ញើដោយស្វ័យប្រវត្តិ'; } else el.style.display='none'; }
let flushing=false;
async function flushPending(){ const url=getScriptUrl(); if(!url||flushing)return; const q=getPending(); if(!q.length){updatePendingNote();return;}
  let tagged=false; q.forEach(it=>{ if(!it.qid){ it.qid=newQid(); tagged=true; } }); if(tagged) setPending(q);
  flushing=true; const snapshot=new Set(q.map(it=>it.qid)); const sent=new Set();
  try{
    for(const item of q){ try{ await fetch(url,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(Object.assign({},item,{register:REGISTER}))}); sent.add(item.qid); }catch(e){ /* stays queued; re-send is safe */ } }
  }finally{
    flushing=false; const now=getPending(); setPending(now.filter(it=>!sent.has(it.qid)));
    if(now.some(it=>!snapshot.has(it.qid))) setTimeout(flushPending,0);
  } }

