function escHtml(s){ return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function todayStr(){ const d=new Date(),p=n=>String(n).padStart(2,'0'); return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }

function parseHcText(text){ const groups=[]; let cur=null; text.split('\n').forEach(raw=>{ const line=raw.trim(); if(!line)return; if(line.startsWith('##')){ cur={od:line.replace(/^##\s*/,'').trim(),facilities:[]}; groups.push(cur);} else { if(!cur){cur={od:'',facilities:[]};groups.push(cur);} cur.facilities.push(line);} }); return groups; }
function flatFacilities(text){ return parseHcText(text).reduce((a,g)=>a.concat(g.facilities),[]); }

