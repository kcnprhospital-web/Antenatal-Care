<!DOCTYPE html>
<html lang="km">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ទម្រង់ចុះបញ្ជីវត្តមាន ANC | KCPH</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="theme-color" content="#0a3a3b">
<meta name="apple-mobile-web-app-title" content="KCPH ANC">
<meta name="application-name" content="KCPH ANC">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Khmer:wght@400;500;600;700&family=Noto+Serif+Khmer:wght@600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1c2b2a;
    --paper:#f6f4ee;
    --card:#ffffff;
    --line:#d8d3c4;
    --teal:#0f5556;
    --teal-dark:#0a3a3b;
    --low:#3f8f5f;
    --low-bg:#e7f3ea;
    --med:#c8912a;
    --med-bg:#fbf1de;
    --high:#b23b3b;
    --high-bg:#fbe9e8;
    --muted:#6b675c;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;background:var(--paper);color:var(--ink);
    font-family:'Noto Sans Khmer','Space Mono',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  header.top{background:var(--teal-dark);color:#f6f4ee;padding:22px 20px 20px;border-bottom:4px solid var(--teal);}
  .top-inner{max-width:980px;margin:0 auto;}
  .eyebrow{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#9fc7bd;margin:0 0 6px;}
  h1{font-family:'Noto Serif Khmer',serif;font-size:22px;margin:0 0 4px;font-weight:700;}
  .sub{font-size:13px;color:#cfe3dd;margin:0;}
  .brand{display:flex;align-items:center;gap:16px;}
  .brand-logo{width:74px;height:74px;flex-shrink:0;background:#fff;border-radius:14px;padding:4px;object-fit:contain;box-shadow:0 1px 4px rgba(0,0,0,.18);}
  @media(max-width:640px){.brand-logo{width:58px;height:58px;}h1{font-size:19px;}}
  nav.tabs{max-width:980px;margin:16px auto 0;display:flex;gap:6px;flex-wrap:wrap;}
  nav.tabs button{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.25);color:#eef5f2;padding:9px 16px;border-radius:999px;font-family:inherit;font-size:13px;cursor:pointer;transition:.15s;}
  nav.tabs button.active{background:#f6f4ee;color:var(--teal-dark);border-color:#f6f4ee;font-weight:600;}
  main{max-width:980px;margin:0 auto;padding:24px 20px 80px;}
  .panel{display:none;}
  .panel.active{display:block;animation:fade .25s ease;}
  @keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:16px;}
  .card h2{font-family:'Noto Serif Khmer',serif;font-size:16px;margin:0 0 14px;padding-bottom:10px;border-bottom:2px solid var(--ink);display:flex;align-items:center;gap:8px;}
  .card h2 .num{font-family:'Space Mono',monospace;font-size:12px;background:var(--ink);color:var(--paper);width:22px;height:22px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  @media(max-width:640px){.grid,.grid3{grid-template-columns:1fr;}}
  label{display:block;font-size:12.5px;font-weight:600;margin-bottom:5px;color:var(--teal-dark);}
  label .opt{font-weight:400;color:var(--muted);}
  input[type=text],input[type=number],input[type=date],input[type=tel],select,textarea{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:7px;font-family:inherit;font-size:14px;background:#fdfcf9;color:var(--ink);}
  input:focus,select:focus,textarea:focus{outline:2px solid var(--teal);outline-offset:1px;border-color:var(--teal);}
  textarea{min-height:64px;resize:vertical;}
  .field{margin-bottom:12px;}
  .risk-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  @media(max-width:640px){.risk-row{grid-template-columns:1fr;}}
  .risk-opt{border:2px solid var(--line);border-radius:var(--radius);padding:14px 12px;cursor:pointer;text-align:center;transition:.15s;background:#fdfcf9;}
  .risk-opt .dot{width:26px;height:26px;border-radius:50%;margin:0 auto 8px;border:2px solid rgba(0,0,0,.15);}
  .risk-opt .lbl{font-weight:700;font-size:14px;margin-bottom:3px;}
  .risk-opt .desc{font-size:11.5px;color:var(--muted);line-height:1.4;}
  .risk-opt[data-risk=low] .dot{background:var(--low);}
  .risk-opt[data-risk=med] .dot{background:var(--med);}
  .risk-opt[data-risk=high] .dot{background:var(--high);}
  .risk-opt.sel[data-risk=low]{background:var(--low-bg);border-color:var(--low);}
  .risk-opt.sel[data-risk=med]{background:var(--med-bg);border-color:var(--med);}
  .risk-opt.sel[data-risk=high]{background:var(--high-bg);border-color:var(--high);}
  .check-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;}
  @media(max-width:640px){.check-grid{grid-template-columns:1fr;}}
  .chk{display:flex;align-items:center;gap:8px;font-size:13.5px;background:#fdfcf9;border:1px solid var(--line);padding:8px 10px;border-radius:7px;cursor:pointer;}
  .chk input{width:auto;}
  button.primary{background:var(--teal-dark);color:#fff;border:none;padding:13px 26px;border-radius:8px;font-family:inherit;font-size:14.5px;font-weight:600;cursor:pointer;width:100%;}
  button.primary:hover{background:var(--teal);}
  button.ghost{background:none;border:1px solid var(--line);color:var(--ink);padding:8px 14px;border-radius:7px;font-family:inherit;font-size:13px;cursor:pointer;}
  .status-msg{margin-top:10px;padding:10px 12px;border-radius:7px;font-size:13px;display:none;}
  .status-msg.ok{display:block;background:var(--low-bg);color:var(--teal-dark);border:1px solid var(--low);}
  .status-msg.err{display:block;background:var(--high-bg);color:var(--high);border:1px solid var(--high);}
  .pending-note{display:none;margin-top:8px;padding:8px 12px;border-radius:7px;font-size:12.5px;background:var(--med-bg);color:#7a5b16;border:1px solid #e6d8a8;}
  .remark-field{margin-top:14px;margin-bottom:0;padding-top:11px;border-top:1px dashed var(--line);}
  .remark-field label{color:var(--muted);}
  .remark-field input{background:#faf9f4;}
  .edit-banner{display:none;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px;padding:12px 16px;border-radius:var(--radius);background:#e7eef7;border:1px solid #b9cbe4;color:#274060;font-size:14px;}
  .edit-banner.show{display:flex;}
  .row-actions{display:flex;gap:6px;white-space:nowrap;}
  .row-btn{border:1px solid var(--line);background:#fdfcf9;border-radius:6px;padding:4px 9px;font-size:12px;cursor:pointer;font-family:inherit;line-height:1.2;}
  .row-btn:hover{background:#f0eee7;}
  .row-btn.del{color:var(--high);border-color:#e6c3c1;}
  .row-btn.del:hover{background:var(--high-bg);}
  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;}
  @media(max-width:640px){.stat-row{grid-template-columns:1fr 1fr;}}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px;text-align:center;}
  .stat .n{font-family:'Space Mono',monospace;font-size:26px;font-weight:700;}
  .stat .l{font-size:11.5px;color:var(--muted);margin-top:2px;}
  .stat.low .n{color:var(--low);} .stat.med .n{color:var(--med);} .stat.high .n{color:var(--high);}
  .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
  .load-status{font-size:12.5px;color:var(--muted);min-height:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .load-status.err{color:var(--high);}
  .load-status .loadall{border:1px solid var(--teal);background:#fff;color:var(--teal-dark);border-radius:6px;padding:3px 10px;font-size:12px;cursor:pointer;font-family:inherit;}
  button.ghost:disabled{opacity:.55;cursor:default;}
  .filters select,.filters input{width:auto;flex:1;min-width:140px;}
  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  th,td{text-align:left;padding:8px 8px;border-bottom:1px solid var(--line);white-space:nowrap;}
  th{font-family:'Space Mono',monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);background:#efece2;position:sticky;top:0;}
  tr:hover td{background:#faf9f4;}
  .table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);}
  .pill{padding:2px 9px;border-radius:999px;font-size:11px;font-weight:700;display:inline-block;}
  .pill.low{background:var(--low-bg);color:var(--low);}
  .pill.med{background:var(--med-bg);color:var(--med);}
  .pill.high{background:var(--high-bg);color:var(--high);}
  .empty{text-align:center;padding:40px 20px;color:var(--muted);font-size:13.5px;}
  .setup-note{background:#fdf6e3;border:1px solid #e6d8a8;border-radius:8px;padding:12px 14px;font-size:12.5px;color:#5c4e1a;margin-bottom:16px;display:none;}
  .setup-note.show{display:block;}
  code{background:#efece2;padding:2px 6px;border-radius:4px;font-family:'Space Mono',monospace;font-size:11.5px;}
  .hc-textarea{min-height:280px;font-family:'Noto Sans Khmer',sans-serif;font-size:13px;line-height:1.7;}
  .small-note{font-size:11.5px;color:var(--muted);margin-top:4px;}

  .anc-hint{font-size:12.5px;color:var(--muted);margin:-4px 0 14px;}
  .opt-tag{font-weight:400;color:var(--muted);font-size:11px;}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
</head>
<body>

<header class="top">
  <div class="top-inner brand">
    <img id="brandLogo" class="brand-logo" alt="KCPH Antenatal Care Record logo">
    <div>
      <p class="eyebrow">Kampong Chhnang Provincial Hospital · Technical Office</p>
      <h1>ទម្រង់ចុះបញ្ជីវត្តមានស្ត្រីមកពិនិត្យផ្ទៃពោះ (ANC)</h1>
      <p class="sub">ANC Attendance Register — quick check-in for women arriving at KCPH</p>
    </div>
  </div>
  <nav class="tabs">
    <button class="tab-btn active" data-tab="entry">➕ ចុះវត្តមាន</button>
    <button class="tab-btn" data-tab="dashboard">📊 បញ្ជីវត្តមាន</button>
    <button class="tab-btn" data-tab="setup">⚙️ ការកំណត់</button>
  </nav>
</header>

<main>
  <!-- ENTRY -->
  <section class="panel active" id="tab-entry">
    <div class="setup-note" id="needSetupNote">⚠️ សូមកំណត់ Google Apps Script URL នៅផ្ទាំង <strong>ការកំណត់</strong> ជាមុនសិន។</div>
    <form id="entryForm">
      <div class="edit-banner" id="editBanner">
        <span>✏️ កំពុងកែប្រែកំណត់ត្រា — <strong id="editBannerName"></strong></span>
        <button type="button" class="ghost" id="cancelEditBtn">បោះបង់ (Cancel)</button>
      </div>
      <div class="card">
        <h2><span class="num">✓</span>ចុះវត្តមានស្ត្រីមកពិនិត្យផ្ទៃពោះ</h2>
        <p class="anc-hint">បំពេញត្រឹមតែ ៣ ចន្លោះចាំបាច់ (កាលបរិច្ឆេទ · មូលដ្ឋានបញ្ជូន · ឈ្មោះ) — ចន្លោះផ្សេងទៀតស្រេចចិត្ត។</p>
        <div class="grid">
          <div class="field">
            <label>កាលបរិច្ឆេទមកដល់ <span class="opt">Attendance date</span></label>
            <input type="date" id="attendDate" required>
          </div>
          <div class="field">
            <label>មូលដ្ឋានសុខាភិបាលបញ្ជូន <span class="opt">Referring facility</span></label>
            <select id="hcName" required><option value="">— ជ្រើសរើស —</option></select>
          </div>
        </div>
        <div class="grid">
          <div class="field">
            <label>ឈ្មោះស្ត្រី <span class="opt">Patient name</span></label>
            <input type="text" id="patName" required>
          </div>
          <div class="grid" style="grid-template-columns:1fr 1fr;">
            <div class="field"><label>អាយុ <span class="opt-tag">optional</span></label><input type="number" id="patAge" min="10" max="60"></div>
            <div class="field"><label>លេខលិខិតបញ្ជូន <span class="opt-tag">optional</span></label><input type="text" id="refNo" placeholder="ឧ. ២៧/២០២៦"></div>
          </div>
        </div>

        <div class="field">
          <label>កម្រិតហានិភ័យ <span class="opt-tag">optional — តាមលិខិតបញ្ជូន</span></label>
          <div class="risk-row" id="riskRow">
            <div class="risk-opt" data-risk="low"><div class="dot"></div><div class="lbl">🟢 ទាប</div></div>
            <div class="risk-opt" data-risk="med"><div class="dot"></div><div class="lbl">🟡 មធ្យម</div></div>
            <div class="risk-opt" data-risk="high"><div class="dot"></div><div class="lbl">🔴 ខ្ពស់</div></div>
          </div>
          <input type="hidden" id="riskLevel">
        </div>

        <div class="grid">
          <div class="field">
            <label>លទ្ធផលនៃការមកពិនិត្យ <span class="opt-tag">optional</span></label>
            <select id="outcome">
              <option value="">— ជ្រើសរើស —</option>
              <option value="បានពិនិត្យ">បានពិនិត្យ (Seen / examined)</option>
              <option value="សម្រាកព្យាបាល">សម្រាកព្យាបាល (Admitted)</option>
              <option value="បញ្ជូនបន្ត">បញ្ជូនបន្ត (Referred onward)</option>
              <option value="មិនបានបញ្ចប់ការពិនិត្យ">មិនបានបញ្ចប់ការពិនិត្យ (Did not complete)</option>
              <option value="ផ្សេងៗ">ផ្សេងៗ (Other)</option>
            </select>
          </div>
          <div class="field">
            <label>កំណត់សម្គាល់ <span class="opt-tag">optional</span></label>
            <input type="text" id="remark" placeholder="ឧ. ណាត់ជួបលើកក្រោយ...">
          </div>
        </div>
      </div>

      <button type="submit" class="primary" id="submitBtn">💾 រក្សាទុកវត្តមាន (Save)</button>
      <div class="status-msg" id="statusMsg"></div>
      <div class="pending-note" id="pendingNote"></div>
    </form>
  </section>

  <!-- DASHBOARD -->
  <section class="panel" id="tab-dashboard">
    <div class="stat-row">
      <div class="stat"><div class="n" id="statTotal">0</div><div class="l">សរុប / Total</div></div>
      <div class="stat low"><div class="n" id="statLow">0</div><div class="l">🟢 ទាប</div></div>
      <div class="stat med"><div class="n" id="statMed">0</div><div class="l">🟡 មធ្យម</div></div>
      <div class="stat high"><div class="n" id="statHigh">0</div><div class="l">🔴 ខ្ពស់</div></div>
    </div>
    <div class="card">
      <h2><span class="num">⌕</span>តម្រង (Filters)</h2>
      <div class="filters">
        <select id="fltHc"><option value="">មូលដ្ឋានទាំងអស់</option></select>
        <select id="fltRisk"><option value="">ហានិភ័យទាំងអស់</option><option value="low">🟢 ទាប</option><option value="med">🟡 មធ្យម</option><option value="high">🔴 ខ្ពស់</option></select>
        <input type="date" id="fltFrom">
        <input type="date" id="fltTo">
        <button class="ghost" id="refreshBtn">🔄 ផ្ទុកឡើងវិញ</button>
        <button class="ghost" id="exportExcelBtn">⬇️ Excel</button>
        <button class="ghost" id="exportPdfBtn">🖨️ PDF (របាយការណ៍)</button>
      </div>
      <div id="loadStatus" class="load-status"></div>
    </div>
    <div class="table-wrap">
      <table id="dataTable">
        <thead><tr>
          <th>កាលបរិច្ឆេទ</th><th>មូលដ្ឋានបញ្ជូន</th><th>លេខលិខិត</th><th>ឈ្មោះ</th><th>អាយុ</th>
          <th>ហានិភ័យ</th><th>លទ្ធផល</th><th>កំណត់សម្គាល់</th><th>សកម្មភាព</th>
        </tr></thead>
        <tbody id="tableBody"><tr><td colspan="9" class="empty">មិនទាន់មានទិន្នន័យ</td></tr></tbody>
      </table>
    </div>
  </section>

  <!-- SETUP -->
  <section class="panel" id="tab-setup">
    <div class="card">
      <h2><span class="num">A</span>ការតភ្ជាប់ (Google Sheet)</h2>
      <p class="small-note" style="margin-top:0;">ទម្រង់នេះប្រើ backend ដូចគ្នានឹងទម្រង់បញ្ជូន ប៉ុន្តែរក្សាទុកទិន្នន័យក្នុងសន្លឹក <code>ANC</code> ដាច់ដោយឡែក។</p>
      <div class="field"><label>Apps Script Web App URL</label><input type="text" id="scriptUrl" placeholder="https://script.google.com/macros/s/.../exec"></div>
      <button class="ghost" id="saveUrlBtn">រក្សាទុក URL</button>
      <span id="urlSaveMsg" style="margin-left:10px;font-size:12.5px;color:var(--low);"></span>
    </div>
    <div class="card">
      <h2><span class="num">B</span>បញ្ជីមូលដ្ឋានសុខាភិបាល</h2>
      <p class="small-note" style="margin-top:0;">បញ្ជីមូលដ្ឋានសុខាភិបាល ៤៨ (តាមស្រុកប្រតិបត្តិ)។ បន្ទាត់ <code>## </code> ជាចំណងជើងស្រុកប្រតិបត្តិ។</p>
      <div class="field"><label>បញ្ជីមូលដ្ឋានសុខាភិបាល</label><textarea id="hcList" class="hc-textarea"></textarea>
      <p class="small-note">បច្ចុប្បន្ន៖ <span id="hcCount">0</span> មូលដ្ឋាន ក្នុង <span id="odCount">0</span> ស្រុកប្រតិបត្តិ។</p></div>
      <button class="ghost" id="saveHcBtn">រក្សាទុកបញ្ជី</button>
      <button class="ghost" id="pushHcBtn">☁️ បញ្ជូនទៅ Sheet</button>
